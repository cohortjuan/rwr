# Copy this file to .env.local and fill in your own values.
# .env.local is ignored by git. Never commit real keys and never paste them into chats.
# Every value below is a placeholder.

# Groq (primary). Create a free key in the Groq console, and turn on Zero Data Retention
# there under Settings > Data Controls.
GROQ_API_KEY=your-groq-api-key-here
# Optional. Use a model your Groq console lists.
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini (optional fallback, off by default). Google's free tier terms say not to
# submit personal information, so only set GEMINI_FALLBACK=on if you accept that for players.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK=off

# Supabase Auth. These two are public by design and safe in the browser.
# Never put the service role or secret key in this project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
