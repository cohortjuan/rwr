# Copy this file to .env.local and fill in your own values.
# .env.local is ignored by git. Never commit real keys and never paste them into chats.
# Every value below is a placeholder.

# Groq (primary). Create a free key in the Groq console, and turn on Zero Data Retention
# there under Settings > Data Controls.
GROQ_API_KEY=your-groq-api-key-here
# Optional. Use a model your Groq console lists.
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini (optional fallback, off by default). Google's free tier terms say not to
# submit personal information, so only set GEMINI_FALLBACK=on if you accept that for players.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK=off

# Supabase Auth. These two are public by design and safe in the browser.
# Never put the service role or secret key in this project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Wardrobe ideas (optional). Players can suggest a new piece from the wardrobe, and it is
# emailed to you from your own mailbox. This is free. With Gmail: turn on 2-Step Verification,
# then make an app password at https://myaccount.google.com/apppasswords and put it in
# MAIL_PASS. It is not your normal password. Leave these two empty and the form stays hidden.
MAIL_USER=
MAIL_PASS=
# Optional. Where ideas are sent (your MAIL_USER if empty), and another mail server.
MAIL_TO=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465

# Dev only, optional. To test on a phone over Wi-Fi, set this to your computer's network
# address (find it with: hostname -I), then open http://that-address:3000 on the phone.
DEV_ORIGINS=
