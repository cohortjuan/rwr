# Copy this file to .env.local and fill in your own values.
# .env.local is ignored by git. Never commit real keys and never paste them into chats.
# Every value below is a placeholder.

# Google Gemini (primary). Create a free key in Google AI Studio.
GEMINI_API_KEY=your-gemini-api-key-here
# Optional. Use a model your AI Studio account lists on the free tier.
GEMINI_MODEL=gemini-2.5-flash

# Groq (automatic fallback when Gemini is rate limited). Create a free key in the Groq console.
GROQ_API_KEY=your-groq-api-key-here
# Optional. Use a model your Groq console lists on the free tier.
GROQ_MODEL=openai/gpt-oss-120b

# Supabase Auth. These two are public by design and safe in the browser.
# Never put the service role or secret key in this project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here
